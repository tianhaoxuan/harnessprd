# harnessprd backend —— 环境变量模板
# 复制为 .env 后填写真实值：Copy-Item .env.example .env
# 注意：.env 已在 .gitignore 中，不要提交真实密钥。

# ---------- LLM ----------
# 留空即视为"未配置"（启动会提示，生成接口返回 503）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 取值：anthropic | openai | deepseek
DEFAULT_LLM_PROVIDER=anthropic
# 留空则按 provider 回退：
#   anthropic → claude-sonnet-4-20250514
#   openai    → gpt-4o-mini
#   deepseek  → deepseek-chat（不在 API 模型清单里，见 README「切换模型」）
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.2
# 上限，不是目标值。4096 被多份设计文档点名不够用（见 core/config.py 注释）
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# ---------- 审核智能体（双智能体里的 Reviewer，可选）----------
# 留空 = 审核员与写手**同一个模型**（同一套 API/Key），只有提示词不同。
# 想降低"自己审自己"的偏差，只换 model 名即可（Key 不用多配一份）：
#   PRD_REVIEW_LLM_MODEL=deepseek-reasoner
# 也可以换供应商（此时要配对应厂商的 Key）：
#   PRD_REVIEW_LLM_PROVIDER=openai
# 配错不会让生成失败：审核员回落到写手的模型并写一条 warning 日志。
PRD_REVIEW_LLM_PROVIDER=
PRD_REVIEW_LLM_MODEL=

# ---------- 技能包 ----------
# PRD 生成走 skills/prd-generator/ 技能包（6 章结构 + FR/AC 编号）。这是产品的默认结构。
# 改成 false 会走 gen_prd.md 的老结构（15 章 + 2 附录）—— 只作回退保留，两套互不兼容，
# 切换前先看 core/config.py 里列的同步清单
PRD_USE_SKILL=true

# ---------- 服务 ----------
# 0.0.0.0 = 监听所有网卡（容器/局域网可访问）；仅本机自用建议改 127.0.0.1
HOST=0.0.0.0
PORT=8000
# 支持三种写法：单个 URL / 逗号分隔 / JSON 数组
CORS_ORIGINS=http://localhost:5173

# ---------- 其他 LLM 供应商（可选）----------
# DeepSeek 走 OpenAI 兼容协议；要用它就把 DEFAULT_LLM_PROVIDER 改成 deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OpenAI 兼容中转站 / 本地 Ollama 填这里；留空走官方地址
OPENAI_BASE_URL=

# ---------- 应用（一般不用改）----------
APP_NAME=harnessprd
VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
# 每次 LLM 调用打一行 JSON 观测日志（event=llm_step）。
# false 时仍会打整趟的 run_summary、SSE 里也仍会有 run_summary，只是不打逐步日志；
# 失败的调用无论开关都会记。
LOG_LLM_METRICS=true

# ---------- 跨分片观测（一份产物 = 一个 run）----------
# 一份产物分多次请求生成时（接口文档 / 提示词套件），各片的账按请求头 X-Run-ID
# 在**进程内**合并成整份；超过 TTL 未再上报就丢弃，超过上限按最后上报时间淘汰最旧。
# 丢了只是少一份合并汇总 —— 每片的 llm_step 日志仍在 app.log 里。
RUN_METRICS_TTL_SECONDS=1800
RUN_METRICS_MAX_RUNS=256

# ---------- Token 预算（业务策略 cap）----------
# 有效 input 上限 = min(cap, 模型物理顶)；物理顶来自 config/models.yaml。
CONTEXT_BUDGET_TOKENS=120000
CHAT_HISTORY_BUDGET=60000
SINGLE_CALL_INPUT_BUDGET=100000
TOKEN_BUDGET_MODE=warn
TOKEN_ESTIMATOR=tiktoken

# ---------- 数据层 ----------
# SQLite：**方案库**（工作台快照 JSON）。留空 = `backend/harnessprd.db`
# 已加进 .gitignore（`*.db`），不要提交本地数据；测试请显式指向临时文件
SQLITE_PATH=
# 写锁等待毫秒数（SQLite 的写锁是**库级**的）。持续 BUSY 说明该换库了，而不是该调大它
SQLITE_BUSY_TIMEOUT_MS=5000

# docker-compose.yml 已提供 Postgres 16 / Redis 7，业务代码尚未接入
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=harnessprd
POSTGRES_PASSWORD=harnessprd_dev
POSTGRES_DB=harnessprd
REDIS_URL=redis://127.0.0.1:6379/0
